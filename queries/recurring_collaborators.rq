PREFIX schema: <https://schema.org/>
PREFIX cine: <https://cinegraph.local/>

SELECT ?other ?name (COUNT(DISTINCT ?title) AS ?shared_titles) WHERE {
  ?title cine:participant <https://cinegraph.local/person/nm1> .
  ?title cine:participant ?other .
  ?other schema:name ?name .
  FILTER(?other != <https://cinegraph.local/person/nm1>)
}
GROUP BY ?other ?name
ORDER BY DESC(?shared_titles) ?name
